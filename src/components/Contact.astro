---
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n/ui';
import { EMAIL, profile } from '../data/profile';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
const mailto = `mailto:${EMAIL}?subject=${encodeURIComponent(t('contact.subject'))}`;
---
<section class="section wrap contact" id="contact" aria-labelledby="contact-title">
  <div class="panel panel-accent" data-reveal>
    <div class="panel-text">
      <p class="eyebrow">{t('contact.kicker')}</p>
      <h2 id="contact-title" class="h2">{t('contact.title')}</h2>
      <p class="lead">{t('contact.lede')}</p>
      <p class="btn-row">
        <a class="btn btn-light" href={mailto}><Icon name="mail" />{t('contact.write')}</a>
        <button class="btn btn-outline-light" type="button" data-copy={EMAIL} data-done={t('contact.copied')}>
          <Icon name="copy" /><span>{t('contact.copy')}</span>
        </button>
      </p>
      <p class="sr-only" aria-live="polite" data-copy-status></p>
    </div>
    <div class="contact-side">
      <p class="eyebrow">Email</p>
      <a class="contact-email" href={mailto}>{EMAIL}</a>
      <ul>
        <li><a href={profile.linkedinUrl} target="_blank" rel="me noopener">LinkedIn</a></li>
        <li><a href={profile.githubUrl} target="_blank" rel="me noopener">GitHub</a></li>
      </ul>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      const label = b.querySelector('span');
      const status = document.querySelector('[data-copy-status]');
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        const old = label?.textContent;
        if (label) label.textContent = b.dataset.done!;
        if (status) status.textContent = b.dataset.done!;
        setTimeout(() => label && old && (label.textContent = old), 2000);
      } catch {
        window.location.href = `mailto:${b.dataset.copy}`;
      }
    }),
  );
</script>
