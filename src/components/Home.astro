---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BriefBuilder from './BriefBuilder.astro';
import ProjectCase from './ProjectCase.astro';
import ChatDemo from './ChatDemo.astro';
import Contact from './Contact.astro';
import Icon from './Icon.astro';
import Frame from './Frame.astro';
import logoSaneo from '../assets/brands/saneo.svg';
import logoAlproperty from '../assets/brands/alproperty.png';
import logoUcs from '../assets/brands/ucs.png';
import logoTdown from '../assets/brands/tdown.svg';
import { projects, getProject, boardType, hostOf } from '../data/projects';
import { services, serviceHref, servicesIndexHref } from '../data/services';
import { profile, BRAND, FOUNDER } from '../data/profile';
import { about } from '../data/about';
import { projectHref, useT, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const ai = profile.bettermileAI?.[lang];
const aiService = services.find((s) => s.id === 'ai-transformation');
const aiSteps = [1, 2, 3, 4] as const;
const aiExamples = [1, 2, 3, 4] as const;
const ab = about[lang];

const fmtDate = (d?: string | null) => {
  if (!d) return t('exp.present');
  const [y, m] = d.split('-').map(Number);
  return m ? new Intl.DateTimeFormat(lang, { month: 'short', year: 'numeric' }).format(new Date(y, m - 1)) : String(y);
};

const tiles = [
  ['booking', 'tiles.booking', '#saneo'],
  ['crm', 'tiles.crm', '#alproperty'],
  ['recruit', 'tiles.recruit', '#ucs'],
  ['video', 'tiles.video', '#circleon'],
  ['ai', 'tiles.ai', '#ai-transformation'],
  ['mobile', 'tiles.mobile', '#tdown'],
  ['compare', 'tiles.compare', '#pushim'],
  ['quiz', 'tiles.quiz', '#quizmaster'],
] as const;

// Hero showcase: one real screen per project, switched by the tabs under it.
const showcase = [
  ['saneo', logoSaneo, '#036499', 'doctor-calendar-day'],
  ['alproperty', logoAlproperty, '#015548', 'website-map-3d'],
  ['ucs', logoUcs, '#f4f1ec', 'player-clip-editor'],
  ['tdown', logoTdown, '#057274', 'flight-mobile'],
].map(([slug, logo, brand, shot]) => {
  const p = getProject(slug as string)!;
  return {
    slug,
    logo,
    brand,
    name: p.name.replace(/\s*\(.*\)$/, ''),
    kind: boardType[slug as string][lang],
    host: hostOf(p.url),
    shot: p.screenshots.find((s) => s.file.includes(`/${shot}.`))!,
  };
}) as { slug: string; logo: ImageMetadata; brand: string; name: string; kind: string; host: string; shot: (typeof projects)[number]['screenshots'][number] }[];

const now = new Date();
const yearsSince = (y: number, m: number) => Math.floor((now.getFullYear() * 12 + now.getMonth() - (y * 12 + m - 1)) / 12);
const numbers = [
  [t('numbers.years'), String(yearsSince(2014, 2)), t('numbers.years.sub')],
  [t('numbers.products'), 'Berlin', t('numbers.products.sub')],
  [t('numbers.bm'), String(projects.length), t('numbers.bm.sub')],
  [t('numbers.langs'), '3', t('numbers.langs.sub')],
];

---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-text">
    <p class="hero-who">
      <span>{t('hero.eyebrow')}</span>
    </p>
    <h1 id="hero-title" class="h1">{t('hero.title')}</h1>
    <p class="lead">{t('hero.lede')}</p>
    <p class="btn-row">
      <a class="btn btn-accent" href="#work">{t('hero.cta')}</a>
      <a class="btn btn-outline" href="#about">{t('hero.cta2')}</a>
    </p>
  </div>

  <div class="hero-show" data-showcase>
    <div class="hero-stage">
      {showcase.map((s, i) => (
        <figure class:list={['hero-shot', { 'is-active': i === 0 }]} id={`hero-shot-${s.slug}`} role="tabpanel" aria-labelledby={`hero-tab-${s.slug}`} data-i={i}>
          {s.shot.kind === 'mobile' ? (
            <div class="hero-device">
              <Frame image={s.shot.image} kind="mobile" alt={`${s.name}: ${s.shot.caption[lang]}`} sizes="240px" />
            </div>
          ) : (
            <Frame image={s.shot.image} kind="desktop" url={s.host} alt={`${s.name}: ${s.shot.caption[lang]}`} eager={i === 0} sizes="(max-width: 900px) 100vw, 760px" />
          )}
          <figcaption>
            <span>{s.shot.caption[lang]}</span>
            <a class="more" href={`#${s.slug}`}>{t('hero.case')} <Icon name="chevron" /></a>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="hero-tabs" role="tablist" aria-label={t('work.title')}>
      {showcase.map((s, i) => (
        <button type="button" class="hero-tab" role="tab" id={`hero-tab-${s.slug}`} aria-controls={`hero-shot-${s.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <span class="hero-tab-logo" style={`--brand: ${s.brand}`}>
            <Image src={s.logo} alt="" width={64} height={64} format={s.logo.format === 'svg' ? 'svg' : 'webp'} />
          </span>
          <span class="hero-tab-text">
            <span class="hero-tab-name">{s.name}</span>
            <span class="hero-tab-kind">{s.kind}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<section class="section wrap aix" id="ai-transformation" aria-labelledby="aix-title">
  <div class="section-head">
    <p class="eyebrow">{t('aix.kicker')}</p>
    <h2 id="aix-title" class="h2">{t('aix.title')}</h2>
    <p>{t('aix.lede')}</p>
  </div>
  <div class="panel aix-panel" data-reveal>
    <ol class="aix-steps">
      {aiSteps.map((n) => (
        <li>
          <span class="aix-num">{n}</span>
          <div>
            <h3>{t(`aix.s${n}.t`)}</h3>
            <p>{t(`aix.s${n}.d`)}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="panel-text aix-side">
      <h3>{t('aix.ex.title')}</h3>
      <ul class="checks">{aiExamples.map((n) => <li>{t(`aix.ex.${n}`)}</li>)}</ul>
      <p class="btn-row">
        {aiService && <a class="btn btn-accent" href={serviceHref(lang, aiService)}>{t('aix.cta')}</a>}
        <a class="btn btn-outline" href="#brief">{t('aix.cta2')}</a>
      </p>
    </div>
  </div>
</section>

<section class="section wrap ai" id="ai" aria-labelledby="ai-title">
  <div class="panel panel-dark" data-reveal>
    <div class="panel-text">
      <p class="eyebrow">{t('ai.kicker')}</p>
      <h2 id="ai-title" class="h2">{ai?.title ?? 'Bekki'}</h2>
      <p class="lead">{ai?.summary ?? t('ai.lede')}</p>
      {ai?.bullets && <ul class="checks">{ai.bullets.map((b) => <li>{b}</li>)}</ul>}
      {profile.bettermileAI?.stack && (
        <ul class="tags">{profile.bettermileAI.stack.map((s) => <li class="tag">{s}</li>)}</ul>
      )}
      <p class="ai-note">{t('ai.note')}</p>
    </div>
    <div class="panel-media">
      <ChatDemo lang={lang} />
    </div>
  </div>
</section>

<section class="section wrap brief-section" id="brief" aria-labelledby="brief-title">
  <BriefBuilder lang={lang} />
</section>

<section class="section wrap" aria-labelledby="tiles-title">
  <div class="section-head">
    <h2 id="tiles-title" class="h2">{t('tiles.title')}</h2>
    <p>{t('tiles.lede')}</p>
  </div>
  <div class="tiles">
    {tiles.map(([icon, key, href]) => (
      <a class="tile" href={href}><Icon name={icon} />{t(key)}</a>
    ))}
  </div>
</section>

<section class="section wrap" id="work" aria-labelledby="work-title">
  <div class="section-head">
    <p class="eyebrow">{t('work.kicker')}</p>
    <h2 id="work-title" class="h2">{t('work.title')}</h2>
    <p>{t('work.lede')}</p>
  </div>
  <div class="cases">
    {projects.map((p, i) => <ProjectCase project={p} lang={lang} index={i} />)}
  </div>
</section>

<section class="section wrap" aria-labelledby="numbers-title">
  <div class="section-head">
    <h2 id="numbers-title" class="h2">{t('numbers.title')}</h2>
  </div>
  <div class="numbers">
    {numbers.map(([label, value, sub]) => (
      <div class="num">
        <p class="num-label">{label}</p>
        <p class="num-value">{value}</p>
        <p class="num-sub">{sub}</p>
      </div>
    ))}
  </div>
</section>

<section class="section wrap" id="services" aria-labelledby="services-title">
  <div class="section-head">
    <p class="eyebrow">{t('services.kicker')}</p>
    <h2 id="services-title" class="h2">{t('services.title')}</h2>
  </div>
  <div class="services-list">
    {services.map((s) => (
      <div class="service">
        <Icon name={s.icon} />
        <h3><a href={serviceHref(lang, s)}>{s.i18n[lang].navLabel}</a></h3>
        <p>{s.i18n[lang].lead}</p>
        <p class="service-seen">
          {t('services.seen')}{' '}
          {s.related.map((p, i) => <>{i > 0 && ', '}<a href={projectHref(lang, p.slug)}>{p.name}</a></>)}
        </p>
        <a class="more" href={serviceHref(lang, s)}>{t('svc.read', { name: s.i18n[lang].navLabel })} <Icon name="chevron" /></a>
      </div>
    ))}
  </div>
  <p class="btn-row" style="margin-top: 32px"><a class="btn btn-outline" href={servicesIndexHref(lang)}>{t('svc.all')}</a></p>
</section>

<section class="section wrap about" id="about" aria-labelledby="about-title">
  <div class="panel" data-reveal>
    <div class="panel-text about-copy">
      <p class="eyebrow">{t('about.kicker')}</p>
      <h2 id="about-title" class="h2">{t('about.title')}</h2>
      {ab.bio.map((para) => <p>{para}</p>)}
    </div>
    <div class="panel-text about-side">
      {profile.photo && (
        <figure class="founder">
          <Image src={profile.photo} alt={FOUNDER} width={128} height={128} format="webp" quality={85} />
          <figcaption><strong>{FOUNDER}</strong><span>{t('about.founder', { brand: BRAND })}</span></figcaption>
        </figure>
      )}
      <dl class="facts">
        {ab.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </div>

  {profile.experience.length > 0 && (
    <div class="timeline">
      <h3>{t('exp.title')}</h3>
      <ol>
        {profile.experience.map((e) => (
          <li>
            <span class="tl-date">{fmtDate(e.start)} – {fmtDate(e.end)}</span>
            {e.roles?.length ? (
              <span class="tl-role">
                <strong>{e.company}</strong>
                <ol class="tl-steps">{e.roles.map((r) => <li>{r}</li>)}</ol>
              </span>
            ) : (
              <span class="tl-role"><strong>{e.title}</strong>, {e.company}</span>
            )}
            {e.location && <span class="tl-loc">{e.location}</span>}
          </li>
        ))}
      </ol>
    </div>
  )}
</section>

<Contact lang={lang} />

<script>
  // Hero showcase tabs: click or arrow keys swap the screen. No autoplay.
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const shots = root.querySelectorAll<HTMLElement>('.hero-shot');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.hero-tab')];
    const show = (i: number, focus = false) => {
      shots.forEach((s) => s.classList.toggle('is-active', s.dataset.i === String(i)));
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === i));
        t.tabIndex = j === i ? 0 : -1;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => show(i)));
    root.querySelector('.hero-tabs')?.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (!['ArrowLeft', 'ArrowRight'].includes(ev.key)) return;
      const cur = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      show((cur + (ev.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length, true);
    });
  });
</script>
