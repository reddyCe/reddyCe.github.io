---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { langs, languages, prefix, homeHref, useT, type Lang } from '../i18n/ui';
import { EMAIL, profile } from '../data/profile';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const t = useT(lang);
const home = homeHref(lang);
const links = [
  ['work', t('nav.work')],
  ['ai', t('nav.ai')],
  ['services', t('nav.services')],
  ['about', t('nav.about')],
] as const;
---
<aside class="topbar" aria-label="Availability and language">
  <div class="wrap topbar-row">
    <span class="topbar-status">{t('status.open')}<span class="muted topbar-hide">· {t('status.where')}</span></span>
    <div class="topbar-links">
      <a class="topbar-hide" href={`mailto:${EMAIL}`}><Icon name="mail" />{EMAIL}</a>
      <a class="topbar-hide" href={profile.linkedinUrl} rel="me noopener" target="_blank">LinkedIn</a>
      <a class="topbar-hide" href={profile.githubUrl} rel="me noopener" target="_blank">GitHub</a>
      <div class="lang-switch" role="group" aria-label="Language">
        <Icon name="globe" />
        {langs.map((l) => (
          <a href={`${prefix(l)}${path}`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={languages[l]}>
            {l.toUpperCase()}
          </a>
        ))}
      </div>
      <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" data-theme-toggle>
        <Icon name="moon" />
      </button>
    </div>
  </div>
</aside>
<header class="mainbar">
  <div class="wrap mainbar-row">
    <a class="logo" href={home} aria-label="Redon Cela, home">
      <Logo />
      <span class="logo-text"><strong>Redon Cela</strong><span>{t('hero.eyebrow')}</span></span>
    </a>
    <nav class="nav" aria-label="Primary">
      {links.map(([id, label]) => <a href={`${home}#${id}`}>{label}</a>)}
    </nav>
    <a class="btn btn-accent" href={`${home}#contact`}>{t('nav.cta')}</a>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  const sync = () => btn?.setAttribute('aria-pressed', String(isDark()));
  sync();
  btn?.addEventListener('click', () => {
    root.dataset.theme = isDark() ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    sync();
  });
</script>
